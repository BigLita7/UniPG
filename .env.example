# MAX Bot
BOT_TOKEN=your_max_bot_token
MAX_BOT_USERNAME=t126_hakaton_max_bot

# Timezone used in event notifications and reminder polling interval
APP_TIMEZONE=Europe/Moscow
REMINDER_POLL_SECONDS=30

# URL of the deployed UniPG Mini App
MINI_APP_URL=https://unipg.ru

# Backend API URL for the bot
# Local:
BACKEND_API_URL=http://127.0.0.1:8000
# Docker example:
# BACKEND_API_URL=http://web:8000

# MAX webhook secret
MAX_BOT_WEBHOOK_SECRET=your_webhook_secret

# Russian Trusted Root CA for Node.js
NODE_EXTRA_CA_CERTS=./certs/russian-trusted-root-ca.pem
# Optional separate CA path for Python requests to MAX API
MAX_CA_CERT_PATH=./certs/russian-trusted-root-ca.pem

# 2GIS MapGL public browser key
TWOGIS_MAPGL_API_KEY=your_2gis_mapgl_key

# 2GIS Places API server-side key
TWOGIS_PLACES_API_KEY=your_2gis_places_key

# Optional 2GIS settings
TWOGIS_MAP_STYLE_ID=
TWOGIS_MOSCOW_CITY_ID=

# Production settings
ALLOWED_ORIGINS=https://unipg.ru,http://127.0.0.1:8000,http://localhost:8000
DATABASE_PATH=mini_app/backend/unipg.db
LOG_LEVEL=INFO
